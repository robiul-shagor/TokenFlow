# Copy to .env.local. Never put a private key or seed phrase in env files.
# Values below are the local (Anvil) defaults; see docs/deployment.md for testnets.

# Network profile: local (default) | sepolia | base-sepolia. Mainnets are not supported.
NETWORK=local

DATABASE_URL=postgres://localhost:5432/tokenflow

# Server-side RPC used by the API and the indexer. Required on testnets, where it usually contains a
# provider API key: it is never sent to the browser.
RPC_URL=http://127.0.0.1:8545

# RPC URL given to the browser. Local: defaults to RPC_URL. Testnets: defaults to the chain's public
# endpoint and must NOT equal RPC_URL.
# PUBLIC_RPC_URL=

# Defaults to ../../contracts/deployments/<chainId>.json
# DEPLOYMENT_MANIFEST=

# Blocks to wait before indexing (default: 0 local, 3 on testnets).
# INDEXER_CONFIRMATIONS=

# Saving reports needs a SCHEDULE_MANAGER_ROLE signature on testnets. Set to 1 to require it locally too.
# REQUIRE_REPORT_SIGNATURE=

# Integration tests use a separate database.
# TEST_DATABASE_URL=postgres://localhost:5432/tokenflow_test
