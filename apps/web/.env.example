# LOCAL DEVELOPMENT ONLY. Copy to .env.local. No secrets belong here: never put a private key or seed phrase in env files.
DATABASE_URL=postgres://localhost:5432/tokenflow
# Local Anvil RPC used by the server and indexer.
RPC_URL=http://127.0.0.1:8545
# RPC URL given to the browser (defaults to RPC_URL).
# PUBLIC_RPC_URL=http://127.0.0.1:8545
# Defaults to ../../contracts/deployments/31337.json
# DEPLOYMENT_MANIFEST=
# Integration tests use a separate database.
# TEST_DATABASE_URL=postgres://localhost:5432/tokenflow_test
